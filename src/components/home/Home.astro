---
import '../../styles/home.css';
import CaseStudy from './CaseStudy.astro';
import { badges, home, links } from '../../data/home.js';

const { lang = 'es' } = Astro.props;
const t = home[lang];
const base = import.meta.env.BASE_URL;
const photo = `${base}javier-barrera.jpg`;
const [featuredCase, ...otherCases] = t.cases;
---

<div class="home">
  <div class="waves-wrap">
  <canvas class="dot-waves" data-fade="copy" aria-hidden="true"></canvas>
  <section class="hero container">
    <div class="hero-copy">
      <h1>{t.hero.name}</h1>
      <p class="hero-role">{t.hero.role}</p>
      <p class="hero-lead">{t.hero.lead}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">{t.hero.primary}</a>
        <a class="button" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="button" href={links.github} target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <img class="hero-photo" src={photo} alt={t.hero.photoAlt} width="800" height="800" fetchpriority="high" />
  </section>
  </div>

  <div class="container">
    <dl class="metrics">
      {t.metrics.map((metric) => (
        <div class="metric">
          <dt>{metric.value}</dt>
          <dd>{metric.label}</dd>
        </div>
      ))}
    </dl>
  </div>

  <section class="work" id="work">
    <div class="container">
      <h2 class="work-title">{t.sections.work}</h2>
    </div>
    <div class="featured-band">
      <div class="container">
        <CaseStudy item={featuredCase} labels={t.labels} featured />
      </div>
    </div>
    <div class="container">
      <div class="case-stack">
        {otherCases.map((item) => <CaseStudy item={item} labels={t.labels} />)}
      </div>
    </div>
  </section>

  <section class="section container" id="projects">
    <h2>{t.sections.projects}</h2>
    <div class="section-body project-list">
      {t.projects.map((project) => (
        <article class="project reveal">
          <h3>{project.name}</h3>
          <div>
            <p>{project.summary}</p>
            <ul class="tags" aria-label={t.labels.stack}>
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container" id="experience">
    <h2>{t.sections.experience}</h2>
    <div class="section-body timeline">
      {t.experience.map((job) => (
        <article class="job reveal">
          <p class="mono-label">{job.date}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="job-org">{job.org}</p>
            <p>{job.text}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container" id="credentials">
    <h2>{t.sections.credentials}</h2>
    <div class="section-body credentials">
      <h3 class="mono-label">{t.labels.certifications}</h3>
      <ul class="badges">
        {badges.map((badge) => (
          <li>
            <a class="badge" href={badge.href} target="_blank" rel="noopener" title={badge.name}>
              <img src={`${base}badges/${badge.file}.webp`} alt={badge.name} width="240" height="240" decoding="sync" />
            </a>
          </li>
        ))}
      </ul>
      <div class="credentials-meta">
        <div>
          <h3 class="mono-label">{t.labels.education}</h3>
          <ul class="plain-list">
            {t.education.map((item) => <li><span>{item}</span></li>)}
          </ul>
        </div>
        <div>
          <h3 class="mono-label">{t.labels.languages}</h3>
          <p>{t.languages}</p>
        </div>
      </div>
      <div class="credentials-stack">
        <h3 class="mono-label">{t.labels.stack}</h3>
        <dl class="stack">
          {t.stack.map((row) => (
            <div>
              <dt>{row.group}</dt>
              <dd>{row.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <div class="waves-wrap contact-wrap">
  <canvas class="dot-waves" aria-hidden="true"></canvas>
  <section class="section container" id="contact">
    <h2>{t.sections.contact}</h2>
    <div class="section-body contact-row reveal">
      <p>{t.contact.text}</p>
      <div class="hero-actions contact-actions">
        <a class="button button-primary" href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a class="button" href={links.github} target="_blank" rel="noopener">GitHub</a>
        {links.email && <a class="button" href={`mailto:${links.email}`}>{links.email}</a>}
      </div>
    </div>
  </section>
  </div>
</div>

<script>
  import '../../scripts/reveal.js';
  import '../../scripts/waves.js';
</script>
