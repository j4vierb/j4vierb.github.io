---
const { item, labels, featured = false } = Astro.props;
---

<article class:list={['case', 'reveal', { 'case-featured': featured }]}>
  <header class="case-head">
    <div>
      <p class="mono-label">{item.context}</p>
      <h3>{item.title}</h3>
      <p class="case-role">{item.role}</p>
    </div>
    <p class="case-figure">
      <strong>{item.highlight.value}</strong>
      <span>{item.highlight.label}</span>
    </p>
  </header>

  <div class="case-body">
    <div class="case-summary">
      <h4>{labels.challenge}</h4>
      <p>{item.challenge}</p>
      <h4 class="accent">{labels.result}</h4>
      <p class="case-result">{item.result}</p>
    </div>
    <div>
      <h4>{labels.did}</h4>
      <ul class="case-list">
        {item.did.map((line) => <li>{line}</li>)}
      </ul>
    </div>
  </div>

  <ul class="tags" aria-label={labels.stack}>
    {item.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</article>
