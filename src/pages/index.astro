---
import BaseLayout from "../layouts/BaseLayout.astro";
import profilePicture from "../../public/photo.svg";
import Link from "../components/Link.astro";
import Highlight from "../components/home/Highlight.astro";
import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/Code.astro";
import ProfileCheck from "../components/icons/ProfileCheck.astro";
import Book from "../components/icons/Book.astro";
import { jsxTemplate } from "preact/jsx-runtime";
import { date } from "astro:schema";

const pageTitle = "Portafolio";

const dataAndMLCourses = [
  {
    title: "Aplicaciones con LLMs",
    subtitle: "LLMs | RAG | NLP",
    description: "Desarrollo de una aplicación que integra un modelo de lenguaje grande (LLM) que hace uso de un sistema de recuperación de información (RAG) para recuperar contexto de notas escritas en Obsidian."
  },
  {
    title: "Deep Learning",
    subtitle: "PyTorch | CNN | RNN | Transformers",
    description: "Implementación de diferentes tipos redes neuronales profundas (MLP, CNN, RNN y Transformers) en PyTorch para resolver problemas de clasificación de imágenes y procesamiento de lenguaje natural."
  },
  {
    title: "Inteligencia de Negocios",
    subtitle: "ML clásico | NLP | Scikit-learn",
    description: "Desarrollo de distintos modelos de machine learning para tareas de clasificación, regresión y clustering, utilizando Python y Scikit-Learn. Adicionalmente se realizó un proyecto de procesamiento del lenguaje natural (NLP) para la clasificación de noticias falsas utilizando modelos como Naive Bayes, Random Forest y XGBoost."
  },
  {
    title: "Probabilidad y Estadística II",
    subtitle: "ANOVA | Regresión | Inferencia estadística",
    description: "Desarrollo de competencias en estadística descriptiva mediante análisis de varianza (ANOVA), modelos de regresión lineal y lógistica. Así mismo se desarrollaron pruebas de hipótesis, estimación de parámetros, intervalos de confianza para los estimadores y revisión de supuestos."
  },
];

/*{
  title: "Fundamentos del machine learning",
  description: "Desarrollo de las competencias basicas en aprendizaje automático: formulación de problemas de optimización, algoritmos de optimización iterativos, regresión lineal, validación cruzada, regularización, modelos de clasificación y fundamentos de redes neuronales."
},*/

const backendAndCloudCourses = [
  {
    title: "Desarrollo de software en nube",
    subtitle: "FastAPI | AWS | APIs asíncronas",
    description: "Construcción y despliegue en AWS de una API REST desarrollada en FastAPI para procesar videos de manera asíncrona utilizando servicios como Elastic Compute Cloud (EC2), Elastic Load Balancer (ELB), Relation Database Service (RDS) y Simple Storage Service (S3)."
  },
  {
    title: "Arquitectura y diseño de software",
    subtitle: "Arquitectura | Atributos de calidad | GCP",
    description: "Diseño y despliegue en Google Cloud Platform de una aplicación web en Django para manejar la matricula de colegios asegurando atributos de calidad como escalabilidad y disponibilidad, utilizando tácticas de arquitectura."
  },
  {
    title: "Aplicaciones nativas en la nube",
    subtitle: "Microservicios | Docker | Kubernetes",
    description: "Desarrollo de una aplicación basada en microservicios utilizando arquitectura hexagonal, contenedores Docker, orquestación con Kubernetes y despliegue en AWS."
  },
  {
    title: "Desarrollo web",
    subtitle: "Frontend | React JS | Backend | Nest JS | Web APIs",
  },
];


const experiences = [
  {
    title: "Monitor del curso introducción a la programación",
    place: "Universidad de los Andes",
    date: "2022/08-2022/12",
    description: "Acompañé y asesoré a estudiantes en el desarrollo de proyectos y laboratorios en Python, trabajando con estructuras de datos basicas y utilizando librerías para análisis y visualización de datos como NumPy, Pandas y Matplotlib. Además, evalué proyectos académicos en conjunto con otro monitor, proporcionando retroalimentación técnica orientada a la mejora del código y al fortalecimiento del proceso de aprendizaje."
  },
  {
    title: "Desarrollador FrontEnd con React - SinfonIA",
    place: "Universidad de los Andes",
    date: "2024/08-2025/03",
    description: "Desarrollé interfaces de usuario interactivas utilizando React, aplicando buenas prácticas de ingeniería de software para asegurar código limpio, mantenible y escalable. Integré una librería de comunicación con ROS para enviar comandos directamente al robot desde la interfaz gráfica."
  }
]

---

<style>
  @import url("./index.css");
</style>

<BaseLayout pageTitle={pageTitle}>
  <section class="hero-section">
    <div class="welcome-text">
      <h2 id="welcome">Hey 👋, ¡Bienvenido a mi portafolio!</h2>
      <p>
        Mi nombre es Javier, soy estudiante de último año de Ingeniería de
        Sistemas y Computación en la Universidad de los Andes. Me especializo en
        <strong>desarrollo BackEnd</strong> y cuento con experiencia en <strong>aplicaciones nativas en
        la nube</strong> y <strong>tecnologías web modernas</strong>.<br />

        También cuento con sólidos conocimientos en <strong>aprendizaje automático (ML)</strong>,
        <strong>aprendizaje profundo (DL)</strong>, <strong>estadística</strong>, <strong>analítica de datos</strong> y <strong>arquitectura
        de software</strong>, con experiencia práctica en el despliegue de proyectos en <em>AWS</em>
        y <em>Google Cloud</em>. Me apasiona crear soluciones eficientes y escalables.
      </p>
    </div>
    <div class="picture-section">
      <img
        src={profilePicture.src}
        alt="profile-picture"
        class="profile-picture"
      />
    </div>
  </section>

  <h2 id="projects"><CodeIcon class="size-7" /> Proyectos</h2>
  <section>
    
  </section>

  <h2 id="experience"><Briefcase class="size-8" /> Experiencia</h2>
  <section>
    <div class="experience-timeline">
      {experiences.map((experience) => (
        <div class="experience-item">
          <h3>{experience.title}</h3>
          <div class="company">{experience.place}</div>
          <div class="date">{experience.date}</div>
          <div class="description">
            {experience.description}
          </div>
        </div>
      ))}
    </div>
  </section>

  <h2 id="coursework"><Book class="size-7" /> Experiencia Académica relevante</h2>
  <section>
    <h3>BackEnd & Computación en la nube</h3>
    <div class="coursework-grid">
      {backendAndCloudCourses.map((course) => (
        <div class="course-card">
          <h3>{course.title}</h3>
          <p><em>{course.subtitle}</em></p>
        </div>
      ))}
    </div>

    <h3>Data & ML</h3>
    <div class="coursework-grid">
      {dataAndMLCourses.map((course) => (
        <div class="course-card">
          <h3>{course.title}</h3>
          <p><em>{course.subtitle}</em></p>
        </div>
      ))}
    </div>
  </section>

  <h2 id="about-me"><ProfileCheck class="size-8" /> Sobre mí</h2>
  <section>
    <p>
      Tengo conocimiento en JavaScript, TypeScript y librerias de interfaz de
      usuario como React. También cuento con conocimiento en Python, bases de
      datos relacionales y no relacionales, para ser precisos he trabajado con
      Django, MySQL y MongoDB. He ganado esta experiencia gracias a proyectos
      que he desarrollado por mi propia cuenta o con personas de mi misma
      carrera.
    </p>
  </section>
</BaseLayout>
